{
  "name": "mock-purchase-order-backend",
  "version": "2.2.1",
  "description": "Three independent mock backends (ERP purchasing, SRM supplier master, TMS logistics) with Postgres persistence and OpenAPI specs, built to demonstrate orchestration, transformation and aggregation in an iPaaS (Axway Amplify Fusion) behind the Supplier Order Collaboration API.",
  "main": "src/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:separate": "SERVICE_MODE=separate node src/index.js",
    "dev": "nodemon --watch src --watch openapi --ext js,json,yaml,sql src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/data/seed.js",
    "seed:reset": "node src/data/seed.js --reset",
    "db:start": "bash scripts/start-postgres.sh",
    "smoke": "node scripts/smoke-test.js",
    "postman": "npx --yes newman run postman/mock-po-backends.postman_collection.json -e postman/local.postman_environment.json",
    "validate:seed": "node tools/validate-seed.js",
    "check:postman": "node tools/check-postman-coverage.js",
    "check": "npm run validate:seed && npm run check:postman",
    "build:seed": "python3 tools/seed/expand_seed.py",
    "build:postman": "python3 tools/build-postman.py",
    "dashboard:stub": "python3 tools/dashboard-stub.py"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
