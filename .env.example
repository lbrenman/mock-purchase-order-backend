# ─────────────────────────────────────────────────────────────────────────────
# Mock Purchase Order Backends — configuration
# Copy to .env and adjust. Every value shown is the default.
# Per-service variables (ERP_*, SRM_*, TMS_*) override the global ones.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_VERSION=1.0.0
LOG_FORMAT=dev                      # morgan format: dev | combined | tiny

# combined = one port (PORT) serving /erp, /srm, /tms  (best for ngrok / Codespaces)
# separate = one port per backend (ERP_PORT, SRM_PORT, TMS_PORT), same path prefixes
SERVICE_MODE=combined
PORT=3000
ERP_PORT=3001
SRM_PORT=3002
TMS_PORT=3003

# Run a subset of backends (comma separated)
ENABLED_SERVICES=erp,srm,tms

# Public URL written into the OpenAPI "servers" entry. Leave empty to derive it
# from the request (X-Forwarded-Host / X-Forwarded-Proto work for ngrok & Codespaces).
# PUBLIC_BASE_URL=https://abcd-1234.ngrok-free.app

# ── Database ────────────────────────────────────────────────────────────────
# One database, three schemas (erp, srm, tms). Point any service at its own DB if you like.
DATABASE_URL=postgresql://api_user:api_pass@localhost:5432/po_backends_db
# ERP_DATABASE_URL=
# SRM_DATABASE_URL=
# TMS_DATABASE_URL=
# For hosted Postgres (Neon, Supabase, RDS) add ?sslmode=require to the URL.

AUTO_MIGRATE=true                   # create tables on start (idempotent)
AUTO_SEED=true                      # load demo data into empty services on start

# ── Security (optional API keys) ─────────────────────────────────────────────
AUTH_MODE=apikey                    # apikey | none  (global default)
# ERP_AUTH_MODE=apikey
# SRM_AUTH_MODE=apikey
# TMS_AUTH_MODE=apikey
ERP_API_KEY=erp-demo-key
SRM_API_KEY=srm-demo-key
TMS_API_KEY=tms-demo-key
# ERP_API_KEY_HEADER=x-api-key
# SRM_API_KEY_HEADER=x-api-key
# TMS_API_KEY_HEADER=x-api-key

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# ERP_RATE_LIMIT_MAX=300
# SRM_RATE_LIMIT_MAX=300
# TMS_RATE_LIMIT_MAX=300

# ── Demo / chaos controls ────────────────────────────────────────────────────
# Enables request headers x-mock-status (force an error) and x-mock-delay-ms (add latency)
CHAOS_ENABLED=true
# Baseline latency per backend (ms) — makes parallel vs sequential orchestration visible
ERP_LATENCY_MS=0
SRM_LATENCY_MS=0
TMS_LATENCY_MS=0
# Random 503 rate per backend (0.0 – 1.0) — demonstrates retry / circuit-breaker patterns
ERP_ERROR_RATE=0
SRM_ERROR_RATE=0
TMS_ERROR_RATE=0
